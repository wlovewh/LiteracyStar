# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=info_literacy

# ---- Redis ----
# 排行榜使用 Redis ZSET；若 Redis 不可用，后端自动降级为内存实现
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DISABLED=false

# ---- 鉴权 ----
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=12h

# ---- 前端跨域 ----
CORS_ORIGIN=http://localhost:5173
