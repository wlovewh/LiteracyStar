# ===== 综合平台后端环境变量 =====
PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=integrated_platform
DB_POOL_LIMIT=8

# 模拟竞赛平台数据库（用于共用 questions 表）
COMPETITION_DB_NAME=info_literacy

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=12h

# 前端来源
CORS_ORIGIN=http://localhost:5174
